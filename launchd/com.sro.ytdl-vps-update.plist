<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.sro.ytdl-vps-update</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Users/zenichi/src/sro/youtube_downloader/update_vps.sh</string>
    </array>
    <!-- 48時間（172800秒）= 2日ごとに実行 -->
    <key>StartInterval</key>
    <integer>172800</integer>
    <key>StandardOutPath</key>
    <string>/tmp/ytdl_vps_update_stdout.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/ytdl_vps_update_stderr.log</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    </dict>
</dict>
</plist>
